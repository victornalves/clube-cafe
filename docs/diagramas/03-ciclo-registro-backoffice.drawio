        <mxCell id="alertas" value="&lt;b&gt;Alertas&lt;/b&gt;&lt;br/&gt;· FALHA_B3: backoffice, com dono e prazo (pendência 1.19)&lt;br/&gt;· Prazo legal: D-10, D-5, D-2 dias úteis (proposta)&lt;br/&gt;· Assinatura parada sem evento (proposta)&lt;br/&gt;· Pendência sem dono em X horas (proposta)&lt;br/&gt;· 401 repetido ou certificado B3 vencendo: infraestrutura, não backoffice" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="1200" y="450" width="320" height="200" as="geometry"/></mxCell>
        <mxCell id="mapa" value="&lt;b&gt;O que o membro vê no mesmo instante&lt;/b&gt;&lt;br/&gt;RASCUNHO → Rascunho&lt;br/&gt;AGUARDANDO_ASSINATURAS → Aguardando assinaturas&lt;br/&gt;RECUSADO_POR_PARTE → Cancelado, ou Rascunho se corrigir&lt;br/&gt;ASSINADO → Em processamento&lt;br/&gt;ENVIANDO_B3 → Em processamento&lt;br/&gt;FALHA_B3 → Em processamento&lt;br/&gt;EM_CORRECAO → Em processamento&lt;br/&gt;AGUARDANDO_REASSINATURA → Aguardando assinaturas&lt;br/&gt;REGISTRADO → Registrado&lt;br/&gt;CANCELADO → Cancelado" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fillColor=#f5f5f5;strokeColor=#666666;"><mxGeometry x="60" y="730" width="460" height="230" as="geometry"/></mxCell>
        <mxCell id="legenda" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br/&gt;Linha cheia: documentado na rev. 1, ou correção já aplicada (T-06, consulta antes de reenviar).&lt;br/&gt;Tracejado laranja: proposta da rev. 2. T-01 a T-04 resolvem lacunas das regras de negócio. T-05 muda uma decisão sua: falha passageira é tratada sem pessoa (pendência 1.15)." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="60" y="980" width="460" height="130" as="geometry"/></mxCell>
