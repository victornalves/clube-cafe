        <mxCell id="prazo" value="&lt;b&gt;Prazo legal de 30 dias úteis&lt;/b&gt; corre em todos os estados entre a emissão e REGISTRADO, inclusive falha e correção. A fila de pendências ordena por prazo restante." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;"><mxGeometry x="360" y="80" width="780" height="44" as="geometry"/></mxCell>
