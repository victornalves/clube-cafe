        <mxCell id="mapa" value="&lt;b&gt;O que o membro ve no mesmo instante&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;RASCUNHO → Rascunho&lt;br/&gt;AGUARDANDO_ASSINATURAS → Aguardando assinaturas&lt;br/&gt;ASSINADO → &lt;b&gt;Em processamento&lt;/b&gt;&lt;br/&gt;ENVIANDO_B3 → &lt;b&gt;Em processamento&lt;/b&gt;&lt;br/&gt;FALHA_B3 → &lt;b&gt;Em processamento&lt;/b&gt;&lt;br/&gt;EM_CORRECAO → &lt;b&gt;Em processamento&lt;/b&gt;&lt;br/&gt;AGUARDANDO_REASSINATURA → Aguardando assinaturas&lt;br/&gt;REGISTRADO → Registrado&lt;br/&gt;CANCELADO / RECUSADO_POR_PARTE → Cancelado&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Quatro estados internos colapsam em um so: o membro nunca sabe que houve falha, exceto na reassinatura, que exige acao dele.&lt;/i&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=10;">
          <mxGeometry x="1160" y="330" width="380" height="290" as="geometry"/>
        </mxCell>

        <mxCell id="lacuna" value="&lt;b&gt;Lacunas encontradas ao desenhar&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;· maquina-de-estados.md nao define transicao de RASCUNHO para CANCELADO. Se o membro desiste antes de enviar para assinatura, nao ha caminho documentado. Ver RN-71 e lacuna L-02.&lt;br/&gt;&lt;br/&gt;· Nao ha limite de tentativas em ENVIANDO_B3. O contrato pode ciclar indefinidamente entre ENVIANDO_B3 e FALHA_B3.&lt;br/&gt;&lt;br/&gt;· AGUARDANDO_REASSINATURA nao tem saida por recusa: se uma parte se recusar a assinar o documento novo, nao ha estado destino." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff4f4;strokeColor=#b85450;fontSize=11;spacing=10;">
          <mxGeometry x="1160" y="660" width="380" height="270" as="geometry"/>
        </mxCell>

