        <mxCell id="subtitulo" value="Cinco estados. Tracejado laranja = transição nova da rev. 2, proposta, espera aceite do cliente. Fonte: maquina-de-estados.md rev. 2." vertex="1" parent="1" style="text;html=1;align=left;fontSize=12;fontColor=#555555;fillColor=none;strokeColor=none;">
