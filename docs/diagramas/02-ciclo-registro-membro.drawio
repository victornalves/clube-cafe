        <mxCell id="legenda" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br/&gt;Linha cheia: documentado na rev. 1, ou correção de desenho já aplicada (T-07).&lt;br/&gt;Tracejado laranja: transição nova proposta na rev. 2. Resolve as lacunas L-01, L-02 e L-08 das regras de negócio.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Fora do MVP:&lt;/b&gt; aditivo depois de Registrado. É aditamento na B3, outra operação." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;">
          <mxGeometry x="60" y="620" width="560" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="decidir" value="&lt;b&gt;O cliente decide&lt;/b&gt; (pendência 1.14)&lt;br/&gt;· T-01 descartar rascunho&lt;br/&gt;· T-02 autor cancelar enquanto ninguém assinou. Depois da 1ª assinatura, vira pedido ao backoffice&lt;br/&gt;· T-03 depois de uma recusa, o autor corrige em vez de começar do zero" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;">
