<mxfile host="app.diagrams.net">
  <diagram name="Ciclo do registro - camada do membro" id="ciclo-membro">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="titulo" value="Ciclo de vida do registro · camada 1, o que o membro ve" vertex="1" parent="1" style="text;html=1;align=left;fontStyle=1;fontSize=20;fillColor=none;strokeColor=none;">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitulo" value="Cinco estados, nenhum deles exige explicacao tecnica. Desenhado exatamente como esta em maquina-de-estados.md, camada 1." vertex="1" parent="1" style="text;html=1;align=left;fontSize=12;fontColor=#555555;fillColor=none;strokeColor=none;">
          <mxGeometry x="40" y="48" width="900" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="m-rascunho" value="&lt;b&gt;Rascunho&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#555;'&gt;so o autor ve&lt;br/&gt;edita tudo · RN-65&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;">
          <mxGeometry x="60" y="180" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="m-aguard" value="&lt;b&gt;Aguardando assinaturas&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#555;'&gt;conteudo congelado · RN-66&lt;br/&gt;documento gerado · RN-67&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;">
          <mxGeometry x="380" y="180" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="m-proc" value="&lt;b&gt;Em processamento&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#555;'&gt;tudo entre assinado e registrado&lt;br/&gt;problema nosso, nao dele&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;">
          <mxGeometry x="700" y="180" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="m-registrado" value="&lt;b&gt;Registrado&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#555;'&gt;terminal. nada muda · RN-69&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1">
          <mxGeometry x="1020" y="180" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="m-cancelado" value="&lt;b&gt;Cancelado&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#555;'&gt;terminal. motivo obrigatorio&lt;br/&gt;nunca apagado · RN-70, RN-72, RN-75&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;">
          <mxGeometry x="540" y="420" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="e-1" edge="1" parent="1" source="m-rascunho" target="m-aguard" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-2" edge="1" parent="1" source="m-aguard" target="m-proc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-3" edge="1" parent="1" source="m-proc" target="m-registrado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-4" edge="1" parent="1" source="m-aguard" target="m-cancelado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.25;entryY=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="350"/>
              <mxPoint x="595" y="350"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-5" edge="1" parent="1" source="m-proc" target="m-cancelado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.75;entryY=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="810" y="350"/>
              <mxPoint x="705" y="350"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="nota-l06" value="&lt;b&gt;Lacuna L-06&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;'&gt;A tabela de mapeamento diz que AGUARDANDO_REASSINATURA aparece ao membro como &quot;Aguardando assinaturas&quot;, vindo de estados que aparecem como &quot;Em processamento&quot;.&lt;br/&gt;&lt;br/&gt;A camada 1 documentada nao tem essa seta de volta. O unico caso em que o estado anda para tras na tela do membro nao esta desenhado.&lt;br/&gt;&lt;br/&gt;Desenhado aqui como esta no doc. A seta faltante nao foi adicionada.&lt;/font&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=12;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;spacingTop=8;">
          <mxGeometry x="860" y="400" width="380" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="nota-l0102" value="&lt;b&gt;Lacunas L-01 e L-02&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;'&gt;L-01 nao existe transicao para descartar um rascunho. Rascunho abandonado fica na base para sempre.&lt;br/&gt;&lt;br/&gt;L-02 nao existe cancelamento pelo membro durante a coleta de assinaturas. A seta para Cancelado, no doc, so existe pela recusa de uma parte.&lt;br/&gt;&lt;br/&gt;Ver RN-71 e a secao 7 das regras de negocio.&lt;/font&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=12;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;spacingTop=8;">
          <mxGeometry x="60" y="400" width="380" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="nota-corte" value="&lt;b&gt;O corte e a primeira assinatura.&lt;/b&gt; Antes dela o membro manda no conteudo. Depois dela o conteudo esta congelado, e so o juridico reabre, por reassinatura." vertex="1" parent="1" style="text;html=1;align=left;fontSize=13;fillColor=none;strokeColor=none;fontColor=#333333;">
          <mxGeometry x="60" y="640" width="1180" height="30" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
