        <mxCell id="c1" value="A2 · Limite de crédito do membro e análise de risco · rev. 2" vertex="1" parent="1" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontStyle=1;fontSize=20;"><mxGeometry x="40" y="16" width="1770" height="30" as="geometry"/></mxCell>
        <mxCell id="c2" value="Como um limite de crédito: o membro negocia até o limite geral X sem intervenção. Acima disso, o registro fica em processamento e a cúpula é avisada com urgência." vertex="1" parent="1" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontSize=12;fontColor=#555555;"><mxGeometry x="40" y="46" width="1770" height="20" as="geometry"/></mxCell>
        <mxCell id="c3" value="Definição e ajuste do limite" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;align=left;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#666666;spacingLeft=8;spacingTop=4;"><mxGeometry x="20" y="90" width="1800" height="190" as="geometry"/></mxCell>
        <mxCell id="c4" value="Uso do limite a cada registro" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;align=left;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#666666;spacingLeft=8;spacingTop=4;"><mxGeometry x="20" y="300" width="1800" height="400" as="geometry"/></mxCell>
        <mxCell id="t1" value="&lt;b&gt;Membro aprovado&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;vem da entrada no clube (A1)&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="40" y="150" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="t2" value="&lt;b&gt;Clube define o limite&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;um valor X, limite geral&lt;br/&gt;sem período por enquanto&lt;br/&gt;critério humano, a definir&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="300" y="140" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="t3" value="&lt;b&gt;Limite ativo&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;o membro opera até X&lt;br/&gt;sem intervenção&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;"><mxGeometry x="600" y="150" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="t4" value="&lt;b&gt;Ajuste do limite&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;a pedido do membro ou por decisão do clube&lt;br/&gt;aprovado por humano · histórico gravado&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="880" y="140" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="t5" value="&lt;b&gt;Reduzir, suspender ou expulsar&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;decisão do clube&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;"><mxGeometry x="1230" y="150" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="c5" value="" edge="1" parent="1" source="t1" target="t2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c6" value="" edge="1" parent="1" source="t2" target="t3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c7" value="revisão" edge="1" parent="1" source="t3" target="t4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=1;exitY=0.2;entryX=0;entryY=0.2;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c8" value="novo limite vigente" edge="1" parent="1" source="t4" target="t3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=0;exitY=0.8;entryX=1;entryY=0.8;dashed=1;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
