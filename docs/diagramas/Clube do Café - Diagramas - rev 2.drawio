        <mxCell id="c2" value="Fica entre o rascunho e o aguardando assinaturas. Novo estado &#x27;Em negociação&#x27;. Termina quando as partes chegam a um acordo." vertex="1" parent="1" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontSize=12;fontColor=#555555;"><mxGeometry x="40" y="46" width="1770" height="20" as="geometry"/></mxCell>
        <mxCell id="b1" value="&lt;b&gt;Registro em rascunho&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;autor escolhe seu lado&lt;br/&gt;informa a contraparte&lt;br/&gt;corretor opcional&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="40" y="300" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="d1" value="Usar a Mesa?" vertex="1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="300" y="290" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="c3" value="" edge="1" parent="1" source="b1" target="d1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="m1" value="&lt;b&gt;Mesa de Negociação&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;vídeo e formulário compartilhado ao vivo&lt;br/&gt;todos veem o preenchimento&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="540" y="130" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="m2" value="&lt;b&gt;Partes acertam os campos&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;quantidade, preço, prazo (mês e ano)&lt;br/&gt;região, armazém&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="840" y="130" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="c4" value="sim" edge="1" parent="1" source="d1" target="m1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=0.5;exitY=0;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c5" value="" edge="1" parent="1" source="m1" target="m2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s1" value="&lt;b&gt;Negociação sem Mesa&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;fora do sistema ou por propostas no sistema&lt;br/&gt;a definir&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="540" y="470" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;Autor preenche o acordado&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;contraparte revisa: aceita ou pede ajuste&lt;br/&gt;a definir&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="840" y="470" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="c6" value="não" edge="1" parent="1" source="d1" target="s1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=0.5;exitY=1;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c7" value="" edge="1" parent="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="d2" value="Houve acordo?" vertex="1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="1150" y="290" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="c8" value="" edge="1" parent="1" source="m2" target="d2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=1;exitY=0.5;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c9" value="" edge="1" parent="1" source="s2" target="d2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=1;exitY=0.5;entryX=0.5;entryY=1;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p1" value="&lt;b&gt;Pré-validação&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;automática&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;"><mxGeometry x="1400" y="305" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="p2" value="&lt;b&gt;Aguardando assinaturas&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;envelope único, janela de 15 min&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="1640" y="295" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="c10" value="sim" edge="1" parent="1" source="d2" target="p1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c11" value="" edge="1" parent="1" source="p1" target="p2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="cx1" value="&lt;b&gt;Cancelado&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;sem acordo&lt;br/&gt;não pede motivo&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;"><mxGeometry x="1150" y="640" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="c12" value="não" edge="1" parent="1" source="d2" target="cx1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n1" value="&lt;b&gt;Em aberto:&lt;/b&gt; a negociação com Mesa pode continuar &lt;b&gt;em paralelo&lt;/b&gt; à assinatura (a câmera fica ligada até a assinatura e o registro), ou termina antes de abrir o envelope? Vale para os dois casos, com e sem Mesa." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="40" y="640" width="540" height="90" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;Em aberto:&lt;/b&gt; sem Mesa, como as partes negociam? Contrapropostas registradas no sistema, ou só o resultado, preenchido pelo autor?" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="620" y="640" width="480" height="90" as="geometry"/></mxCell>
