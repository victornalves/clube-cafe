        <mxCell id="u1" value="&lt;b&gt;Registro assinado&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;fim da janela de assinatura&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="40" y="420" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="u2" value="&lt;b&gt;Sistema soma a exposição&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;contratos em aberto do membro&lt;br/&gt;+ este registro&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;"><mxGeometry x="290" y="410" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="u3" value="Soma acima do limite?" vertex="1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="610" y="395" width="190" height="120" as="geometry"/></mxCell>
        <mxCell id="u4" value="&lt;b&gt;Segue para a B3&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;sem intervenção, em processamento normal&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;"><mxGeometry x="880" y="320" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="u5" value="&lt;b&gt;Registro fica em processamento&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;retido: não vai à B3&lt;br/&gt;enquanto não houver decisão&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="880" y="410" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="u6" value="&lt;b&gt;Aviso urgente à cúpula do clube&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;e-mail e ligação automática por IA&lt;br/&gt;a um membro de análise&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="1190" y="410" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="u7" value="&lt;b&gt;Agente de análise avalia o risco para o clube&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;dentro do período de aceitação (a definir)&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="1190" y="550" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="u8" value="&lt;b&gt;Liberar&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;segue para a B3&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;"><mxGeometry x="1520" y="480" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="u9" value="&lt;b&gt;Negar o registro&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;risco para o clube&lt;br/&gt;sem explicação, previsto nos termos&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;"><mxGeometry x="1520" y="570" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="c10" value="" edge="1" parent="1" source="u1" target="u2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
