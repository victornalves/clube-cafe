  <diagram name="B3 · Estados do registro (membro)" id="b3-estados-membro">
    <mxGraphModel dx="1400" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="B3 · Ciclo de vida do registro · camada 1, o que o membro vê · rev. 2" vertex="1" parent="1" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontStyle=1;fontSize=20;"><mxGeometry x="40" y="16" width="1520" height="30" as="geometry"/></mxCell>
        <mxCell id="c2" value="Seis estados. Novo: &#x27;Em negociação&#x27;. A revisão do clube fica escondida em &#x27;Em processamento&#x27;." vertex="1" parent="1" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontSize=12;fontColor=#555555;"><mxGeometry x="40" y="46" width="1520" height="20" as="geometry"/></mxCell>
        <mxCell id="m1" value="&lt;b&gt;Rascunho&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;só o autor vê · edita tudo&lt;br/&gt;inclui a pré-validação automática&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="40" y="220" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="m2" value="&lt;b&gt;Em negociação&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;com ou sem Mesa (B2)&lt;br/&gt;até as partes chegarem a acordo&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="300" y="220" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="m3" value="&lt;b&gt;Aguardando assinaturas&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;envelope único, conteúdo congelado&lt;br/&gt;janela de 15 min (configurável)&lt;br/&gt;se expirar, o autor reabre ou cancela&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="560" y="220" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="m4" value="&lt;b&gt;Em processamento&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;assinado até registrado&lt;br/&gt;inclui análise de limite e risco&lt;br/&gt;o backoffice resolve&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;"><mxGeometry x="850" y="220" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="m5" value="&lt;b&gt;Registrado&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;na B3&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;"><mxGeometry x="1150" y="220" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="m6" value="&lt;b&gt;Cancelado&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;terminal · nunca apagado&lt;br/&gt;cancelar sem assinatura não pede motivo (RN-72)&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;"><mxGeometry x="480" y="500" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="c3" value="iniciar negociação" edge="1" parent="1" source="m1" target="m2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c4" value="acordo fechado" edge="1" parent="1" source="m2" target="m3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c5" value="todos assinaram" edge="1" parent="1" source="m3" target="m4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c6" value="B3 confirmou" edge="1" parent="1" source="m4" target="m5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c7" value="parte recusou · autor corrige" edge="1" parent="1" source="m3" target="m1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;strokeColor=#d79b00;exitX=0.3;exitY=0;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="170"/><mxPoint x="150" y="170"/></Array></mxGeometry></mxCell>
        <mxCell id="c8" value="reassinatura" edge="1" parent="1" source="m4" target="m3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=0.3;exitY=0;entryX=0.8;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="130"/><mxPoint x="740" y="130"/></Array></mxGeometry></mxCell>
        <mxCell id="c9" value="descartar" edge="1" parent="1" source="m1" target="m6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;strokeColor=#d79b00;exitX=0.5;exitY=1;entryX=0.1;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="440"/><mxPoint x="518" y="440"/></Array></mxGeometry></mxCell>
        <mxCell id="c10" value="sem acordo" edge="1" parent="1" source="m2" target="m6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;strokeColor=#d79b00;exitX=0.5;exitY=1;entryX=0.3;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c11" value="autor cancela antes da 1ª assinatura" edge="1" parent="1" source="m3" target="m6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;strokeColor=#d79b00;exitX=0.5;exitY=1;entryX=0.6;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c12" value="negado pelo clube / backoffice cancela" edge="1" parent="1" source="m4" target="m6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=0.5;exitY=1;entryX=0.9;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="o1" value="&lt;b&gt;E depois de Registrado?&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;chegou o mês e ano de entrega: o registro fica &#x27;Registrado&#x27; para sempre&lt;br/&gt;ou há um status posterior (em entrega, liquidado, vencido)?&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="1150" y="400" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="c13" value="" edge="1" parent="1" source="m5" target="o1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="o2" value="&lt;b&gt;Como um registro é alterado?&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;liquidação preliminar (antecipada) da CPR&lt;br/&gt;ou em dia. Hoje, fora do MVP: aditivo depois de Registrado&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="1150" y="540" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="c14" value="" edge="1" parent="1" source="o1" target="o2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n1" value="&lt;b&gt;Em aberto:&lt;/b&gt; a negociação pode correr em paralelo à assinatura (com e sem Mesa)? Se sim, &#x27;Em negociação&#x27; e &#x27;Aguardando assinaturas&#x27; coexistem. Ver B2." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="40" y="640" width="540" height="80" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;Prazo legal de 30 dias úteis&lt;/b&gt; da emissão até o registro (Lei 8.929/1994). Começa no envio ou na última assinatura? Pendência 2.8." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;"><mxGeometry x="620" y="640" width="480" height="80" as="geometry"/></mxCell>
        <mxCell id="leg1150" value="Legenda de cores" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fontStyle=1;"><mxGeometry x="1150" y="680" width="300" height="138" as="geometry"/></mxCell>
        <mxCell id="leg1150_0" value="Definido com o cliente (reuniões 2 e 3)" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="1162" y="710" width="276" height="22" as="geometry"/></mxCell>
        <mxCell id="leg1150_1" value="Proposta nossa, a validar" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="1162" y="738" width="276" height="22" as="geometry"/></mxCell>
        <mxCell id="leg1150_2" value="Em aberto, decidir com o Vado" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="1162" y="766" width="276" height="22" as="geometry"/></mxCell>
