        <mxCell id="c6" value="todos assinaram" edge="1" parent="1" source="a4" target="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
