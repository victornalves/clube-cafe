        <mxCell id="n1" value="&lt;b&gt;Campos removidos:&lt;/b&gt; tipo, classificação, safra e modalidade de liquidação. &lt;b&gt;Mantidos:&lt;/b&gt; quantidade, preço, região, armazém. &lt;b&gt;Novo e obrigatório:&lt;/b&gt; prazo de entrega, só mês e ano, sempre do 1º ao último dia do mês de referência." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;"><mxGeometry x="40" y="760" width="700" height="80" as="geometry"/></mxCell>
