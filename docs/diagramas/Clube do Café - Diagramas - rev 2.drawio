        <mxCell id="leg1440_2" value="Em aberto, decidir com o Vado" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="1452" y="846" width="276" height="22" as="geometry"/></mxCell>
