        <mxCell id="c1" value="A1 · Entrada no clube · proposta de adesão · rev. 2" vertex="1" parent="1" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontStyle=1;fontSize=20;"><mxGeometry x="40" y="16" width="1770" height="30" as="geometry"/></mxCell>
        <mxCell id="c2" value="Clube fechado. Nenhuma conta nasce sem decisão humana registrada (RN-01). O candidato anexa as cartas; as 3 partes assinam pelo mesmo fluxo de assinatura do registro." vertex="1" parent="1" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontSize=12;fontColor=#555555;"><mxGeometry x="40" y="46" width="1770" height="20" as="geometry"/></mxCell>
        <mxCell id="a1" value="&lt;b&gt;Candidato preenche o pedido&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;dados da empresa ou pessoa&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="40" y="130" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="a2" value="&lt;b&gt;Indica 2 proponentes&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;exatamente 2, obrigatórios&lt;br/&gt;sem poder adicionar mais&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="290" y="130" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="a3" value="&lt;b&gt;Candidato anexa as 2 cartas&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;uma carta de recomendação de cada proponente&lt;br/&gt;em vez de texto livre&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="540" y="130" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="a4" value="&lt;b&gt;Envelope de assinatura&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;3 partes: candidato + 2 proponentes&lt;br/&gt;mesmo fluxo de assinatura do registro&lt;br/&gt;link com validade maior (a definir)&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="790" y="120" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="a5" value="&lt;b&gt;Pedido enviado&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;acusa o recebimento&lt;br/&gt;sem prazo mostrado&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="1040" y="130" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="a6" value="&lt;b&gt;Fila do comitê de admissão&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;Vado e comitê recebem notificação ou telefonema (ideal)&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="1290" y="130" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="c3" value="" edge="1" parent="1" source="a1" target="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
