        <mxCell id="a4" value="sim" edge="1" parent="1" source="achou" target="registrado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;strokeColor=#d79b00;fontColor=#8a5a00;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" value="não" edge="1" parent="1" source="achou" target="reenvia" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;strokeColor=#d79b00;fontColor=#8a5a00;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6" value="↺ nova resposta" edge="1" parent="1" source="reenvia" target="inicio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;dashed=1;strokeColor=#d79b00;fontColor=#8a5a00;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1400" y="350"/><mxPoint x="1400" y="142"/><mxPoint x="820" y="142"/></Array></mxGeometry></mxCell>
        <mxCell id="falha" value="&lt;b&gt;FALHA_B3&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#444;'&gt;alerta ao backoffice · entra na fila, ordenada por prazo legal&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;"><mxGeometry x="600" y="490" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="corr" value="&lt;b&gt;EM_CORRECAO&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#444;'&gt;operador assume · vê erro inteiro, documento, envio, tentativas e prazo&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;"><mxGeometry x="600" y="600" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="a7" value="não · erro definitivo" edge="1" parent="1" source="passageiro" target="falha" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a8" value="N tentativas esgotadas" edge="1" parent="1" source="reenvia" target="falha" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;dashed=1;strokeColor=#d79b00;fontColor=#8a5a00;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="350"/><mxPoint x="1000" y="525"/></Array></mxGeometry></mxCell>
        <mxCell id="h1" value="" edge="1" parent="1" source="falha" target="corr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q0" value="&lt;b&gt;A causa era passageira e já passou?&lt;/b&gt;" vertex="1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="610" y="710" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;b&gt;1 · Reenviar&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#444;'&gt;consulta a B3 antes. Se achou, reconcilia. Se não, reenvia. Aplicado (T-06)&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;"><mxGeometry x="240" y="720" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="q1" value="&lt;b&gt;O dado errado aparece no documento assinado?&lt;/b&gt;" vertex="1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="600" y="870" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;2 · Corrigir o envio&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#444;'&gt;erro nosso de mapeamento. Documento continua válido. Grava o diff&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;"><mxGeometry x="240" y="885" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="q2" value="&lt;b&gt;O contrato já produziu efeito?&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;'&gt;jurídico decide · pendência 2.13&lt;/font&gt;" vertex="1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="920" y="870" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="c3a" value="&lt;b&gt;3a · Substituição&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#444;'&gt;não produziu efeito. Documento anterior cancelado e arquivado. Nova assinatura&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;"><mxGeometry x="920" y="1030" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="c3b" value="&lt;b&gt;3b · Aditivo&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#444;'&gt;produziu efeito. Anterior preservado, o novo referencia. Nova assinatura&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;"><mxGeometry x="1220" y="1030" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;4 · Cancelar&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#444;'&gt;sem solução. Motivo obrigatório. Segunda pessoa aprova? pendência 1.16&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;"><mxGeometry x="1220" y="595" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="duvida" value="Dúvida sobre efeito: encaminhar ao jurídico antes de escolher (RN-78)" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;verticalAlign=middle;spacingTop=0;"><mxGeometry x="1220" y="770" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="h2" value="" edge="1" parent="1" source="corr" target="q0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h3" value="sim" edge="1" parent="1" source="q0" target="c1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h4" value="não" edge="1" parent="1" source="q0" target="q1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h5" value="não" edge="1" parent="1" source="q1" target="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h6" value="sim" edge="1" parent="1" source="q1" target="q2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h7" value="não" edge="1" parent="1" source="q2" target="c3a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h8" value="sim" edge="1" parent="1" source="q2" target="c3b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="930"/></Array></mxGeometry></mxCell>
        <mxCell id="h9" value="sem solução" edge="1" parent="1" source="corr" target="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="regra" value="&lt;b&gt;A regra, em duas perguntas&lt;/b&gt;&lt;br/&gt;1. O dado errado aparece no documento assinado? Não: correção técnica. Sim: nova assinatura.&lt;br/&gt;2. Se sim, o contrato já produziu efeito? Não: substituição. Sim: aditivo." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fillColor=#ffffff;strokeColor=#666666;"><mxGeometry x="60" y="1010" width="480" height="110" as="geometry"/></mxCell>
      <mxCell id="nota-r3" value="&lt;b&gt;Reunião 3.&lt;/b&gt; Esta tela cobre só o que falha depois do envio à B3. Registro retido por limite, risco ou suspeita de fraude acontece antes do envio e não passa por aqui: ver A2 e o estado EM_ANALISE_CLUBE em B4." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;"><mxGeometry x="900" y="475" width="680" height="75" as="geometry"/></mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  <diagram name="C1 · Liquidação e entrega" id="c1-liquidacao">
    <mxGraphModel dx="1400" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="C1 · Liquidação planejada · entrega, armazém e amostra · rev. 2" vertex="1" parent="1" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontStyle=1;fontSize=20;"><mxGeometry x="40" y="16" width="1720" height="30" as="geometry"/></mxCell>
        <mxCell id="c2" value="Liquidação dentro do clube. Cenário de sucesso: entrega. Fluxo espelha a B3. Os status do registro ainda precisam ser mapeados." vertex="1" parent="1" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontSize=12;fontColor=#555555;"><mxGeometry x="40" y="46" width="1720" height="20" as="geometry"/></mxCell>
        <mxCell id="l1" value="&lt;b&gt;Registrado&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;o armazém foi definido na assinatura&lt;br/&gt;como condição do contrato&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;"><mxGeometry x="40" y="150" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="l2" value="&lt;b&gt;Mês de referência da entrega&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;do 1º ao último dia do mês&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="300" y="150" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="l3" value="&lt;b&gt;Armazém separa a amostra lacrada&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;e remete para aprovação&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="560" y="150" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="l4" value="&lt;b&gt;Classificação da amostra&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;árbitro classificador&lt;br/&gt;não pode estar &#x27;impedido&#x27; (vínculo declarado)&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="820" y="140" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="l5" value="Amostra aprovada?" vertex="1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="1110" y="130" width="190" height="120" as="geometry"/></mxCell>
        <mxCell id="l6" value="&lt;b&gt;Entrega concluída&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;posto-armazém sujeito à aprovação de amostra, idêntico à B3&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;"><mxGeometry x="1350" y="150" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="l7" value="&lt;b&gt;Liquidado&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;dentro do clube · cenário de sucesso&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;"><mxGeometry x="1620" y="150" width="150" height="80" as="geometry"/></mxCell>
        <mxCell id="l8" value="&lt;b&gt;Amostra não aprovada&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;A DEFINIR: avaliar o processo da B3&lt;br/&gt;(tolerância, reclassificação, negócio cai?)&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="1070" y="340" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="c3" value="" edge="1" parent="1" source="l1" target="l2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c4" value="" edge="1" parent="1" source="l2" target="l3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c5" value="" edge="1" parent="1" source="l3" target="l4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c6" value="" edge="1" parent="1" source="l4" target="l5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c7" value="sim" edge="1" parent="1" source="l5" target="l6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c8" value="" edge="1" parent="1" source="l6" target="l7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c9" value="não" edge="1" parent="1" source="l5" target="l8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="l9" value="&lt;b&gt;Troca de partes&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;alguém assume o contrato no lugar do outro&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="40" y="340" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="c10" value="opção na liquidação" edge="1" parent="1" source="l1" target="l9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=0.3;exitY=1;entryX=0.3;entryY=0;dashed=1;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="l10" value="&lt;b&gt;Aditivo&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;trocar partes por aditamento ao mesmo contrato&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="380" y="340" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="l11" value="&lt;b&gt;Distrato e novo contrato&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;desfaz o antigo, o novo assume&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="650" y="340" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="c11" value="opção A" edge="1" parent="1" source="l9" target="l10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c12" value="opção B" edge="1" parent="1" source="l9" target="l11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="460"/><mxPoint x="775" y="460"/></Array></mxGeometry></mxCell>
        <mxCell id="o1" value="&lt;b&gt;Chegou o mês e ano de entrega: e o registro?&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;fica &#x27;Registrado&#x27; para sempre&lt;br/&gt;ou há um status posterior: em entrega, liquidado, vencido?&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="40" y="540" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="o2" value="&lt;b&gt;Como um registro é alterado?&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;liquidação preliminar (antecipada) da CPR&lt;br/&gt;ou em dia. Qual o fluxo de cada uma?&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="500" y="540" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="l12" value="&lt;b&gt;Seguro de performance&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;oferecido aos dois lados da transação&lt;br/&gt;serviço padrão para todos, se acharmos quem ofereça&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="960" y="540" width="330" height="90" as="geometry"/></mxCell>
        <mxCell id="l13" value="&lt;b&gt;Mapear os status do registro&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;da assinatura à entrega e liquidação&lt;br/&gt;a partir do processo da B3&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="1330" y="540" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="n1" value="&lt;b&gt;Fora desta fase:&lt;/b&gt; operações de curto prazo (pronta entrega). Só depois que o clube provar ser seguro. Foco em contrato futuro e qualidade padrão." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;"><mxGeometry x="40" y="680" width="620" height="70" as="geometry"/></mxCell>
        <mxCell id="leg720" value="Legenda de cores" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fontStyle=1;"><mxGeometry x="720" y="680" width="300" height="138" as="geometry"/></mxCell>
        <mxCell id="leg720_0" value="Definido com o cliente (reuniões 2 e 3)" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="732" y="710" width="276" height="22" as="geometry"/></mxCell>
        <mxCell id="leg720_1" value="Proposta nossa, a validar" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="732" y="738" width="276" height="22" as="geometry"/></mxCell>
        <mxCell id="leg720_2" value="Em aberto, decidir com o Vado" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="732" y="766" width="276" height="22" as="geometry"/></mxCell>
        <mxCell id="leg720_3" value="Passo automático do sistema" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;"><mxGeometry x="732" y="794" width="276" height="22" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="C2 · Armazém: dois papéis" id="c2-armazem">
    <mxGraphModel dx="1400" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="C2 · Armazém · cadastro como entrega x cadastro como negociante · rev. 2" vertex="1" parent="1" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontStyle=1;fontSize=20;"><mxGeometry x="40" y="16" width="1420" height="30" as="geometry"/></mxCell>
        <mxCell id="c2" value="Pendente de avaliar com o Vado. Armazém credenciado NÃO é membro automático." vertex="1" parent="1" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontSize=12;fontColor=#555555;"><mxGeometry x="40" y="46" width="1420" height="20" as="geometry"/></mxCell>
        <mxCell id="w0" value="&lt;b&gt;Ingresso de armazém&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;mesmo processo de membro:&lt;br/&gt;2 proponentes + validação&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="540" y="110" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="w1" value="&lt;b&gt;Armazém geral&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;só armazena · não compra nem vende&lt;br/&gt;não pertence a um comerciante&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="140" y="290" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="w2" value="&lt;b&gt;Armazém membro (não geral)&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;negociante: compra e vende&lt;br/&gt;é parte de negociação&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="880" y="290" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="c3" value="começamos por aqui" edge="1" parent="1" source="w0" target="w1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=0.2;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c4" value="depois, a decidir" edge="1" parent="1" source="w0" target="w2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=0.8;exitY=1;entryX=0.5;entryY=0;dashed=1;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="w3" value="&lt;b&gt;Papel: armazém de entrega&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;aparece no campo &#x27;armazém&#x27; do registro&lt;br/&gt;separa a amostra lacrada e remete para aprovação&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="140" y="450" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="w4" value="&lt;b&gt;Papel: parte de negociação&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;pode ser comprador ou vendedor&lt;br/&gt;sujeito aos limites do clube (A2)&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="880" y="450" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="c5" value="" edge="1" parent="1" source="w1" target="w3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c6" value="" edge="1" parent="1" source="w2" target="w4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="w5" value="&lt;b&gt;Em aberto:&lt;/b&gt; como representar isso no sistema. Um cadastro com dois papéis? Dois tipos de cadastro? O armazém membro também pode ser armazém de entrega? Decidir com o Vado antes de modelar." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="540" y="330" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="w6" value="Armazéns gerais podem ser credenciados. Quem aprova, que documentos apresenta e a validade do credenciamento seguem na pendência 1.37." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;"><mxGeometry x="140" y="600" width="560" height="60" as="geometry"/></mxCell>
        <mxCell id="leg1000" value="Legenda de cores" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fontStyle=1;"><mxGeometry x="1000" y="600" width="300" height="138" as="geometry"/></mxCell>
