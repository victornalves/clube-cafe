        <mxCell id="c2" value="Novos: EM_NEGOCIACAO (reunião 3), EM_ANALISE_CLUBE (limite e risco), PRE_VALIDANDO e JANELA_EXPIRADA (rev. 3 da máquina de estados). Fonte: maquina-de-estados.md." vertex="1" parent="1" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontSize=12;fontColor=#555555;"><mxGeometry x="40" y="46" width="1870" height="20" as="geometry"/></mxCell>
