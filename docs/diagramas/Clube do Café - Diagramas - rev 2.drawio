        <mxCell id="u10" value="&lt;b&gt;Suspeita de fraude&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;assinam tudo, mas não registra na B3&lt;br/&gt;até um humano confirmar&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;"><mxGeometry x="290" y="570" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="c18" value="também retém" edge="1" parent="1" source="u10" target="u5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=1;exitY=0.5;entryX=0.3;entryY=1;dashed=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="646" y="610"/></Array></mxGeometry></mxCell>
        <mxCell id="n1" value="&lt;b&gt;Dúvida:&lt;/b&gt; &#x27;este agente pode negar o registro&#x27;. É a pessoa de análise da cúpula, ou o agente de IA da ligação? O Vado disse na reunião 3 que o algoritmo chama a atenção e &lt;b&gt;não decide&lt;/b&gt;. Confirmar antes de modelar." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="40" y="730" width="720" height="80" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;Em aberto:&lt;/b&gt; valor do limite, se terá período (hoje é um limite geral), quem define e quem aprova ajuste, limite inicial por quantidade, tempo máximo de espera da análise (análogo aos 15 min da assinatura), canal de aviso." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="800" y="730" width="640" height="80" as="geometry"/></mxCell>
        <mxCell id="leg1480" value="Legenda de cores" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fontStyle=1;"><mxGeometry x="1480" y="730" width="300" height="138" as="geometry"/></mxCell>
