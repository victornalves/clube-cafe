        <mxCell id="a4x" value="&lt;b&gt;Proponente nega a assinatura&lt;/b&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;"><mxGeometry x="700" y="290" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="a4y" value="&lt;b&gt;Link expira sem assinatura&lt;/b&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;"><mxGeometry x="890" y="290" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="a4z" value="&lt;b&gt;Proposta não segue&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;candidato é avisado&lt;br/&gt;pode refazer o pedido&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;"><mxGeometry x="790" y="400" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="c8" value="nega" edge="1" parent="1" source="a4" target="a4x" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=0.3;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c9" value="expira" edge="1" parent="1" source="a4" target="a4y" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=0.7;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c10" value="" edge="1" parent="1" source="a4x" target="a4z" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=0.5;exitY=1;entryX=0.25;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c11" value="" edge="1" parent="1" source="a4y" target="a4z" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=0.5;exitY=1;entryX=0.75;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a7" value="&lt;b&gt;Comitê analisa&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;reunião semanal, decisão offline&lt;br/&gt;backoffice lança a decisão&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="1290" y="290" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="c12" value="" edge="1" parent="1" source="a6" target="a7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a8" value="Decisão?" vertex="1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="1310" y="420" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="c13" value="" edge="1" parent="1" source="a7" target="a8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a9" value="&lt;b&gt;Em diligência&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;comitê pede mais dados&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="1040" y="435" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="c14" value="pede dados" edge="1" parent="1" source="a8" target="a9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c15" value="respondido" edge="1" parent="1" source="a9" target="a7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;exitX=0.5;exitY=0;entryX=0;entryY=0.5;dashed=1;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a11" value="&lt;b&gt;Recusada&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;sem bloqueio automático&lt;br/&gt;pode propor de novo quando quiser&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;"><mxGeometry x="1560" y="430" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="c16" value="recusa" edge="1" parent="1" source="a8" target="a11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a10" value="&lt;b&gt;Aprovada&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;backoffice cria a conta&lt;br/&gt;e define o limite inicial (A2)&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;"><mxGeometry x="1290" y="600" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="c17" value="aprova" edge="1" parent="1" source="a8" target="a10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a12" value="&lt;b&gt;Aceite dos termos do clube&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;assinado pelo fluxo de assinatura&lt;br/&gt;reassina quando a versão mudar&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="1030" y="600" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="c18" value="" edge="1" parent="1" source="a10" target="a12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a13" value="&lt;b&gt;Membro ativo&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;pode negociar e registrar&lt;br/&gt;até o limite definido&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;"><mxGeometry x="780" y="600" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="c19" value="" edge="1" parent="1" source="a12" target="a13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a14" value="&lt;b&gt;Expulso pelo clube&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#555;&#x27;&gt;decisão humana&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;"><mxGeometry x="530" y="600" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="c20" value="expulsão" edge="1" parent="1" source="a13" target="a14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n1" value="&lt;b&gt;Armazém entra pelo mesmo processo&lt;/b&gt; (2 proponentes + validação), mas &lt;b&gt;não vira membro automaticamente&lt;/b&gt;. Armazém geral é cadastrado para entrega e não negocia. Ver C2." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="40" y="760" width="540" height="80" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;Nomes mudaram.&lt;/b&gt; Antes: &#x27;proponente&#x27; = quem pede, &#x27;recomendante&#x27; = quem indica. Agora o Vado chama quem indica de &#x27;proponente&#x27;. Aqui, quem pede é &lt;b&gt;&#x27;candidato&#x27;&lt;/b&gt;. Confirmar com o Vado." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="620" y="760" width="540" height="80" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;Em aberto:&lt;/b&gt; prazo de validade do link de assinatura da proposta (maior que os 15 min do registro); como um proponente de fora do clube assina (pendência 1.27); comitê no sistema ou só relatório (1.28); via expressa (1.30)." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="1200" y="760" width="580" height="80" as="geometry"/></mxCell>
        <mxCell id="leg40" value="Legenda de cores" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fontStyle=1;"><mxGeometry x="40" y="870" width="300" height="138" as="geometry"/></mxCell>
        <mxCell id="leg40_0" value="Definido com o cliente (reuniões 2 e 3)" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="52" y="900" width="276" height="22" as="geometry"/></mxCell>
        <mxCell id="leg40_1" value="Proposta nossa, a validar" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="52" y="928" width="276" height="22" as="geometry"/></mxCell>
        <mxCell id="leg40_2" value="Em aberto, decidir com o Vado" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;"><mxGeometry x="52" y="956" width="276" height="22" as="geometry"/></mxCell>
        <mxCell id="leg40_3" value="Passo automático do sistema" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;"><mxGeometry x="52" y="984" width="276" height="22" as="geometry"/></mxCell>
      </root>
