  <diagram name="Caminhos de resolucao (rev. 2)" id="caminhos-rev2">
    <mxGraphModel dx="1600" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="Resolução de falha no registro da B3 · rev. 2" vertex="1" parent="1" style="text;html=1;align=left;fontStyle=1;fontSize=20;fillColor=none;strokeColor=none;"><mxGeometry x="40" y="16" width="1000" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitulo" value="O sistema trata sozinho o que é passageiro. Uma pessoa decide todo o resto, com duas perguntas. Tracejado laranja = proposta, espera aceite." vertex="1" parent="1" style="text;html=1;align=left;fontSize=12;fontColor=#555555;fillColor=none;strokeColor=none;"><mxGeometry x="40" y="46" width="1300" height="20" as="geometry"/></mxCell>
        <mxCell id="lane-auto" value="Automático · o sistema resolve sem pessoa (T-05, proposta · pendência 1.15)" vertex="1" parent="1" style="swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;opacity=30;pointerEvents=0;dashed=1;"><mxGeometry x="40" y="80" width="1560" height="340" as="geometry"/></mxCell>
        <mxCell id="lane-hum" value="Humano · o operador decide, com justificativa escrita" vertex="1" parent="1" style="swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;opacity=30;pointerEvents=0;"><mxGeometry x="40" y="450" width="1560" height="700" as="geometry"/></mxCell>
        <mxCell id="inicio" value="&lt;b&gt;Resposta da B3&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#444;'&gt;ou ausência de resposta&lt;/font&gt;" vertex="1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="620" y="115" width="200" height="55" as="geometry"/></mxCell>
        <mxCell id="passageiro" value="&lt;b&gt;Erro passageiro?&lt;/b&gt;&lt;br/&gt;401 · 408 · 429 · 5xx · timeout" vertex="1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="600" y="190" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="consulta" value="&lt;b&gt;Consulta a B3&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#444;'&gt;por Número de Controle&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#d79b00;dashed=1;"><mxGeometry x="920" y="195" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="achou" value="&lt;b&gt;Achou o registro?&lt;/b&gt;" vertex="1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;strokeColor=#d79b00;"><mxGeometry x="1200" y="190" width="160" height="90" as="geometry"/></mxCell>
        <mxCell id="registrado" value="&lt;b&gt;REGISTRADO&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#444;'&gt;reconcilia, fecha a pendência&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;"><mxGeometry x="1420" y="205" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="reenvia" value="&lt;b&gt;Reenvia o mesmo envio&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#444;'&gt;tentativa k de N&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#d79b00;dashed=1;"><mxGeometry x="1180" y="320" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="nota-auto" value="&lt;b&gt;Sempre para uma pessoa&lt;/b&gt;&lt;br/&gt;· Todo 422, porque só o conteúdo do erro, lido contra o documento, decide entre caminho 2 e 3.&lt;br/&gt;· 422 de duplicidade: consultar antes de cancelar. Pode ser um registro nosso que já entrou.&lt;br/&gt;· 401 repetido vai para infraestrutura, não para o backoffice." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fillColor=#ffffff;strokeColor=#666666;"><mxGeometry x="60" y="120" width="500" height="160" as="geometry"/></mxCell>
