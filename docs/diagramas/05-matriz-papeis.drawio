        </mxCell>
        <mxCell id="subtitulo" value="As duas configuracoes lado a lado, para o cliente decidir com a tabela na frente. Toda permissao e negada por padrao (RN-41). visitante e membro estao documentados; os tres papeis de backoffice sao proposta nossa e o cliente nunca opinou." vertex="1" parent="1" style="text;html=1;align=left;fontSize=12;fontColor=#555555;fillColor=none;strokeColor=none;">
          <mxGeometry x="40" y="62" width="1400" height="40" as="geometry"/>
        </mxCell>
